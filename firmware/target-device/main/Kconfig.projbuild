menu "Board C IoT device"
config TARGET_WIFI_SSID
    string "Station AP SSID (private sdkconfig only)"
    default ""
config TARGET_WIFI_PASSWORD
    string "Station AP passphrase (private sdkconfig only)"
    default ""
config TARGET_UI_HOST
    string "UI computer IPv4 address"
    default "192.168.78.10"
config TARGET_UI_PORT
    int "PC authenticated device TLS port (UI stays on 8000)"
    range 1 65535
    default 8443
config TARGET_DEVICE_ID
    string "Device ID (match PC server --device-id)"
    default "iot-c6"
config TARGET_POLL_MS
    int "Command polling interval (ms)"
    range 250 2000
    default 500
config TARGET_LED_GPIO
    int "Addressable RGB LED GPIO"
    range -1 48 if IDF_TARGET_ESP32S3
    range 0 30 if IDF_TARGET_ESP32C6
    default -1 if IDF_TARGET_ESP32S3
    default 8 if IDF_TARGET_ESP32C6
    help
        Set the verified carrier-board WS2812 pin before building for S3.
        The module memory suffix does not identify the onboard LED pin.
endmenu
