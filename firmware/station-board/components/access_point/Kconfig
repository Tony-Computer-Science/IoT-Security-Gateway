menu "Station board WPA2 access point"
config GW_AP_SSID
    string "Access point SSID"
    default "IoT-Gateway"
config GW_AP_PASSWORD
    string "WPA2 passphrase (8-63 bytes; never commit sdkconfig)"
    default ""
config GW_AP_IP
    string "Private AP gateway IPv4 (RFC1918, /24, ending in .1)"
    default "192.168.78.1"
    help
        Must not overlap the SPI link or Board B's upstream network.
        DHCP defaults to .100 through .199 in this /24. The UI computer's
        static address defaults to .10, outside that automatic pool.
        Both boards keep their link addresses under Gateway board link.
config GW_AP_DHCP_FIRST_HOST
    int "First automatic DHCP address (last octet)"
    range 2 253
    default 100
config GW_AP_DHCP_LAST_HOST
    int "Last automatic DHCP address (last octet)"
    range 3 254
    default 199
config GW_AP_UI_HOST
    int "UI computer static address (last octet, excluded from DHCP)"
    range 2 254
    default 10
    help
        Configure this static address on the UI computer itself. This option
        validates that the DHCP pool cannot assign that address to others;
        it is not a MAC-based DHCP reservation or an access-control identity.
config GW_AP_CHANNEL
    int "2.4 GHz channel"
    range 1 11
    default 6
config GW_AP_MAX_CLIENTS
    int "Maximum associated devices"
    range 1 10
    default 4
config GW_AP_LEASE_MINUTES
    int "DHCP lease duration (minutes)"
    range 2 1440
    default 5
endmenu
