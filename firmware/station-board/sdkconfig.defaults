# Board A (station board) defaults. Tracked in git.
# NEVER put Wi-Fi credentials, keys, or passwords here (R2). Set them with
# `idf.py menuconfig`, which writes the git-ignored `sdkconfig`.

CONFIG_IDF_TARGET="esp32s3"

# TODO(hardware): confirm the module's flash size (DevKitC-1 ships with
# N8 / N16 / N32 modules). 4 MB is a safe lower bound that fits partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table retaining an unused legacy LittleFS partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_GW_SPI_CONTROLLER=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV4_NAPT_PORTMAP=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_LEASE_UNIT=60
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=10

# The legacy www partition is unmounted and unused. The UI/API runs on a
# separate server (the fixed-IP PC in the demo), not on this board.
