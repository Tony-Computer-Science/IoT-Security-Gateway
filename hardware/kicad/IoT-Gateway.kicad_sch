	)
	(text "Board A (U1) joins the upstream Wi-Fi as a station. Board B (U2) hosts the private AP for Board C.\nThe SPI bus (SCLK, MOSI, MISO, CS) and the HS handshake line are the ONLY signals between A and B.\nPower is shared (either USB-C port feeds the ORing and the 3V3 buck); USB data never crosses.\nA is SPI controller; B can only signal A by raising HS. FW-01: B's AP channel = farthest of 1/6/11 from A's."
		(exclude_from_sim no)
		(at 27.94 45.72 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "df0c1da4-613c-5128-846f-c944cd175c0f")
	)
	(text "SECURITY BOUNDARY"
