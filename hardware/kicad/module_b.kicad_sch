	)
	(text "EN: 10k / 1u RC power-up delay.\nGPIO0 = BOOT (internal pull-up)."
		(exclude_from_sim no)
		(at 27.94 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "448138f1-125a-567d-afe1-0df1919c1986")
	)
	(text "SPI LINK"
		(exclude_from_sim no)
		(at 26.67 148.59 0)
		(effects
			(font
				(face "Anton")
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "dec96397-ae9f-5733-aacc-44cfaca22e8a")
	)
	(text "B = SPI peripheral. 33R series on MISO and HS.\n10k pull-up keeps CS high while A boots."
		(exclude_from_sim no)
		(at 27.94 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3ac0156-9c77-5e42-b3c2-50899c498745")
	)
	(text "Strapping pins GPIO3, GPIO45, GPIO46 are left open; GPIO0 is BOOT only (HW-11).\nSPI on FSPI IO_MUX pins: CS = GPIO10, MOSI = GPIO11, SCLK = GPIO12, MISO = GPIO13. HS = GPIO4 (HW-04).\nNative USB: GPIO19 = D-, GPIO20 = D+ (flashing and console, HW-05). UART0 not broken out.\nPin map is identical on A and B and matches the breadboard demo (HW-12)."
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "545c0d8a-51a5-53b5-9511-5d4f75c82e04")
	)
	(text "BOARD B"
		(exclude_from_sim no)
		(at 25.4 35.56 0)
