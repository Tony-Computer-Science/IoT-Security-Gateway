	)
	(text "Sink only: Rd = 5.1k on CC1 and CC2.\n100k bleeds VBUS so the opposite LM66100\nCE sees 0 V when this port is unplugged.\nUSBLC6 clamps D+, D- and VBUS (HW-09)."
		(exclude_from_sim no)
		(at 66.04 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b7fb956c-8320-5b99-aab1-c960e767d7fe")
	)
	(text "IDEAL-DIODE ORING"
		(exclude_from_sim no)
		(at 153.67 201.93 0)
		(effects
			(font
				(face "Anton")
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "31fa67c2-011e-55ae-a9f4-66cc72380199")
	)
	(text "CE of each LM66100 tied to the opposite VBUS\n(TI SLVSEZ8A sec. 9.2.1, Figure 15):\nthe higher VBUS wins, make-before-break,\nno reverse current into either host (HW-06).\nST unused: tied to GND per pin table."
		(exclude_from_sim no)
		(at 162.56 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5217f0c6-0c06-5d9e-93d6-d24e565153fc")
	)
	(text "3V3 BUCK"
		(exclude_from_sim no)
		(at 270.51 125.73 0)
		(effects
			(font
				(face "Anton")
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "22688265-5bdf-5661-9a50-6e0e41344319")
	)
	(text "Vout = 0.6 V x (1 + 453k/100k) = 3.32 V  (SLVSDG1C eq. 2)\nL = 2.2 uH, Cout = 22 uF here + 2 x 22 uF at the modules (Table 4)\nCin = 10 uF >= 4.7 uF (sec. 8.2.2.5). EN tied to VIN.\nRating: 1 A continuous on 3V3 (HW-07), 2 A device limit."
		(exclude_from_sim no)
		(at 276.86 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "79d3617f-f9d5-54ed-b40f-1efb43596142")
	)
