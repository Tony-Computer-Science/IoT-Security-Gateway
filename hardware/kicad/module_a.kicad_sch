		)
		(uuid "2cce5543-2292-5a1d-b353-764dbe1d5b61")
	)
	(text "RESET / BOOT"
		(exclude_from_sim no)
		(at 26.67 85.09 0)
		(effects
			(font
				(face "Anton")
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "24b4a597-f0b8-5c64-a0bb-473a1fb4d067")
	)
	(text "EN: 10k / 1u RC power-up delay.\nGPIO0 = BOOT (internal pull-up)."
		(exclude_from_sim no)
		(at 27.94 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fc4c7851-f421-5dd3-9df4-c2d563b0ef41")
	)
	(text "SPI LINK"
		(exclude_from_sim no)
		(at 26.67 148.59 0)
		(effects
			(font
				(face "Anton")
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "e6bab173-70f2-5856-a0d7-46b606842a69")
	)
	(text "A = SPI controller. 33R series at the driver.\n10k pull-down keeps HS low while B boots."
		(exclude_from_sim no)
		(at 27.94 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "03c4a1b8-5db5-5ebf-9928-474e5e9d01a2")
	)
	(text "Strapping pins GPIO3, GPIO45, GPIO46 are left open; GPIO0 is BOOT only (HW-11).\nSPI on FSPI IO_MUX pins: CS = GPIO10, MOSI = GPIO11, SCLK = GPIO12, MISO = GPIO13. HS = GPIO4 (HW-04).\nNative USB: GPIO19 = D-, GPIO20 = D+ (flashing and console, HW-05). UART0 not broken out.\nPin map is identical on A and B and matches the breadboard demo (HW-12)."
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e2a75ccc-1191-5489-bbaa-87db5029ea7c")
	)
	(text "BOARD A"
